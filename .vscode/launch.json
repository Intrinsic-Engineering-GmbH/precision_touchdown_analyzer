{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: touchdown_analyzer CLI",
      "type": "debugpy",
      "request": "launch",
      "module": "touchdown_analyzer",
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Python: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}"
    }
  ]
}
